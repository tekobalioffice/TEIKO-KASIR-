# Salin ke .env.test.local dan isi. File .env.test.local TIDAK di-commit (gitignored).

# Akun Admin/Owner (bisa email atau username — sama seperti form login app)
E2E_ADMIN_USER=admin@teiko.com
E2E_ADMIN_PASS=

# Akun Cabang (role "branch") — dipakai untuk flow kasir dari sisi staff
E2E_BRANCH_USER=
E2E_BRANCH_PASS=

# Akun Gudang (role "gudang") — flow Mode Pengiriman (pos-gudang-pengiriman.spec.js).
# Kosongkan → test-nya di-skip.
E2E_GUDANG_USER=
E2E_GUDANG_PASS=

# Nama outlet KHUSUS TEST di DB produksi. Semua transaksi test dibatasi ke sini.
# Buat dulu lewat menu Admin > Cabang (atau kasih tahu saya untuk seed-nya).
E2E_TEST_OUTLET=TEST-E2E

# Opsional: override URL kalau app dijalankan di port lain / sudah di-deploy
# E2E_BASE_URL=http://localhost:5173

# Opsional: service-role key Supabase untuk cleanup data test lewat API.
# Tanpa ini, cleanup dilakukan best-effort lewat UI + anon key (kena RLS).
# SUPABASE_SERVICE_ROLE_KEY=
